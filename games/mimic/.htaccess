# ECOCAOS — configuración opcional para Apache (https://beatan.com.co/games/mimic/)
# Si el hosting no usa Apache, este archivo se ignora sin consecuencias.

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType audio/mpeg .mp3
  AddType image/svg+xml .svg
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  # El micrófono solo se puede pedir desde este mismo origen.
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Archivos con hash en el nombre: caché larga. index.html: siempre revalidar.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|index\.json|manifest\.json|\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

Options -Indexes
DirectoryIndex index.html
