# Las subidas solo pueden ser imágenes re-codificadas por el servidor.
Options -Indexes -ExecCGI
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>
Require all denied
<FilesMatch "(?i)^[a-f0-9]{24}(_t)?\.(webp|jpe?g|png)$">
  Require all granted
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
</IfModule>
